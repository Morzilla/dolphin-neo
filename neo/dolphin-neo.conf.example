# Settings of dolphin-neo. Copy to ~/.config/dolphin-neo.conf and remove the leading # from the lines you want.
# No quotes, no spaces around the = sign.

# --- file list (details view) ---
# Two-line rows without columns (default) or the stock columns
#DOLPHIN_NEO_LIST=columns
# Icon-less rows with the file type as a watermark (default) or keep the icons
#DOLPHIN_NEO_ICONS=show
# Row style: card (default), open, line, stripe (stock), none. The button in the bar switches card/open and remembers it.
#DOLPHIN_NEO_ROWS=card
# How the file type is marked at the start of a row: watermark (default: faint icon and large abbreviation),
# or a line glyph with the abbreviation as tile, pill, signs or header
#DOLPHIN_NEO_MARK=watermark
# How the abbreviation of the watermark is drawn: fill (default), outline, label
#DOLPHIN_NEO_SIGLA=fill
# Extra space between auto-sized columns, in pixels (only with DOLPHIN_NEO_LIST=columns)
#DOLPHIN_NEO_COLGAP=28

# --- icons view ---
# Dark rounded tiles and rounded previews (default) or the stock look
#DOLPHIN_NEO_TILES=off

# --- sidebar ---
# Glass panel (default) or the stock look
#DOLPHIN_NEO_SIDEBAR=plain
# image (default): a static, blurred picture placed by the window position. lava: slow drifting blobs in the
# picture's colours (LAVA_SPEED 5-100, default 30). live: the compositor's blur shows through.
#DOLPHIN_NEO_GLASS_MODE=image
#DOLPHIN_NEO_LAVA_SPEED=30
# Kind of animation in lava mode: flow (default, a gradient that flows and always fills the panel) or blobs
#DOLPHIN_NEO_LAVA_STYLE=flow
# Lava blob size (10-100, default 55) and colours: empty = teal, amber and indigo; wallpaper = taken from the
# backdrop picture; or a comma-separated list
#DOLPHIN_NEO_LAVA_SIZE=55
#DOLPHIN_NEO_LAVA_COLORS=#2f6f8f,#8a5a2c,#3c4a78
# Picture for image mode. Without it the Plasma wallpaper of the screen is used.
#DOLPHIN_NEO_GLASS_IMAGE=/path/to/picture.png
# How much of the picture shows (0-100) and how blurred it is (0-100)
#DOLPHIN_NEO_GLASS=55
#DOLPHIN_NEO_GLASS_BLUR=45
# Keep the "Devices" section of Places (it is hidden because the panel shows the disk usage at the bottom)
#DOLPHIN_NEO_DEVICES=show
