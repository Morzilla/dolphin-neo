#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# ng-transcribe FILE: writes the spoken text of an audio or video file next to it, as FILE-base.txt (and, for
# videos, FILE-base.srt subtitles). Runs on this computer with whisper.cpp: nothing is uploaded.
#
# It looks for whisper.cpp's whisper-cli in $NG_WHISPER, ~/.local/src/whisper.cpp/build/bin, then $PATH, and for a
# model in $NG_WHISPER_MODEL or ~/.local/share/ng-transcribe/ggml-*.bin. First time:
#   ng-transcribe --setup      builds whisper.cpp in ~/.local/src and downloads the model (about 550 MB)
# The work runs at low priority on half of the processors, so the desktop stays smooth.
# If NG_PROGRESS_FILE is set (Dolphin NG sets it), the percentage done is written there, one number, while it works.
set -uo pipefail
MODELDIR="${XDG_DATA_HOME:-$HOME/.local/share}/ng-transcribe"
MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin"
SRC="${NG_WHISPER_SRC:-$HOME/.local/src/whisper.cpp}"
it() { case "${LANG:-}${LANGUAGE:-}" in it*|*:it*) return 0 ;; *) return 1 ;; esac; }
say() { if it; then echo "$2"; else echo "$1"; fi; }
note() { command -v notify-send >/dev/null && notify-send -a "Dolphin NG" -i "${3:-audio-x-generic}" "$1" "$2" 2>/dev/null; }

cli() {
    for c in "${NG_WHISPER:-}" "$SRC/build/bin/whisper-cli" "$(command -v whisper-cli 2>/dev/null)"; do
        [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
    done
    return 1
}
model() {
    [ -n "${NG_WHISPER_MODEL:-}" ] && [ -s "$NG_WHISPER_MODEL" ] && { echo "$NG_WHISPER_MODEL"; return 0; }
    ls -S "$MODELDIR"/ggml-*.bin 2>/dev/null | head -1 | grep . || return 1
}

if [ "${1:-}" = --setup ]; then
    set -e
    if ! cli >/dev/null; then
        tag=$(git ls-remote --tags --refs https://github.com/ggml-org/whisper.cpp.git 'v1.*' | awk -F/ '{print $3}' | sort -V | tail -1)
        [ -d "$SRC/.git" ] || git clone -q --depth 1 --branch "$tag" https://github.com/ggml-org/whisper.cpp.git "$SRC"
        cmake -S "$SRC" -B "$SRC/build" -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=ON -DWHISPER_BUILD_TESTS=OFF >/dev/null
        nice -n 15 cmake --build "$SRC/build" --target whisper-cli -j"${JOBS:-$(( ($(nproc) + 1) / 2 ))}"
    fi
    if ! model >/dev/null; then
        mkdir -p "$MODELDIR"
        curl -fL -o "$MODELDIR/model.part" "$MODEL_URL" && mv "$MODELDIR/model.part" "$MODELDIR/$(basename "$MODEL_URL")"
    fi
    say "ready: $(cli) with $(model)" "pronto: $(cli) con $(model)"
    exit 0
fi

IN="${1:-}"
[ -f "$IN" ] || { say "usage: ng-transcribe FILE | --setup" "uso: ng-transcribe FILE | --setup"; exit 1; }
W=$(cli) || { note "$(say 'Transcription not set up' 'Trascrizione non configurata')" "$(say 'Run once: ng-transcribe --setup' 'Lancia una volta: ng-transcribe --setup')" dialog-warning; exit 1; }
M=$(model) || { note "$(say 'No speech model' 'Manca il modello vocale')" "$(say 'Run once: ng-transcribe --setup' 'Lancia una volta: ng-transcribe --setup')" dialog-warning; exit 1; }

dir=$(dirname "$IN"); name=$(basename "$IN"); base="${name%.*}"
tmp=$(mktemp --suffix=.wav); trap 'rm -f "$tmp"' EXIT
# whisper wants 16 kHz mono PCM
nice -n 15 ffmpeg -nostdin -loglevel error -y -i "$IN" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$tmp" || { note "$(say 'Could not read the audio' "Impossibile leggere l'audio")" "$name" dialog-error; exit 1; }
threads=$(( ($(nproc) + 1) / 2 ))
outputs=(-otxt); case "$(file -b --mime-type "$IN")" in video/*) outputs+=(-osrt) ;; esac
start=$(date +%s)
P="${NG_PROGRESS_FILE:-}"; real=/dev/null
# whisper tells how far it is only once per 30 s of audio, so between those steps the figure is estimated
# from the time taken so far and how fast the last transcriptions went (seconds of work per second of audio)
SPEED="${XDG_CACHE_HOME:-$HOME/.cache}/ng-transcribe/speed"
audio=$(( $(stat -c %s "$tmp") / 32000 + 1 ))   # 16 kHz, 16 bit, mono
ratio=$(cat "$SPEED" 2>/dev/null | grep -E '^[0-9.]+$' || echo 1.1)
if [ -n "$P" ]; then
    echo 0 > "$P"
    real="$P.whisper"; echo 0 > "$real"
    (
        while sleep 1; do
            r=$(cat "$real" 2>/dev/null); r=${r:-0}
            guess=$(awk -v e=$(( $(date +%s) - start )) -v a="$audio" -v k="$ratio" 'BEGIN { g = int(100 * e / (a * k)); print (g > 95 ? 95 : g) }')
            echo $(( r > guess ? r : guess )) > "$P"
        done
    ) &
    ticker=$!
    trap 'rm -f "$tmp" "$real"; kill $ticker 2>/dev/null' EXIT
    progress=(-pp)
else
    progress=()
fi
if nice -n 15 "$W" -m "$M" -f "$tmp" -l auto -t "$threads" -np "${progress[@]}" "${outputs[@]}" -of "$dir/$base" 2> >(
        while IFS= read -r line; do
            case "$line" in *"progress ="*) n=${line##*= }; n=${n%%%*}; echo $(( ${n// /} )) > "$real" ;; esac
        done) >/dev/null; then
    secs=$(( $(date +%s) - start ))
    [ -n "$P" ] && echo 100 > "$P"
    mkdir -p "$(dirname "$SPEED")"; awk -v s="$secs" -v a="$audio" 'BEGIN { if (a >= 10) printf "%.2f\n", s / a }' > "$SPEED.new" && [ -s "$SPEED.new" ] && mv "$SPEED.new" "$SPEED"; rm -f "$SPEED.new"
    note "$(say 'Transcribed' 'Trascritto')" "$base.txt · ${secs} s" text-plain
else
    note "$(say 'Transcription failed' 'Trascrizione non riuscita')" "$name" dialog-error; exit 1
fi
