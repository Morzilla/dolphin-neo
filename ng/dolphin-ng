#!/bin/bash
# Launch the Dolphin installed by ng/build.sh.
# Settings: one NAME=value per line in ~/.config/dolphin-ng.conf (see ng/dolphin-ng.conf.example);
# values given in the environment win.
P="${DOLPHIN_NG_PREFIX:-$HOME/.local/dolphin-ng}"
if [ -r "$HOME/.config/dolphin-ng.conf" ]; then
    while IFS='=' read -r name value; do
        case "$name" in DOLPHIN_NG_*) [ -n "${!name+x}" ] || export "$name=$value" ;; esac
    done < "$HOME/.config/dolphin-ng.conf"
fi
export XDG_DATA_DIRS="$P/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# (the library folder is lib64, lib or lib/<architecture> depending on the distribution)
PLUGINS="$P/lib64/plugins:$P/lib64/qt6/plugins:$P/lib/plugins:$P/lib/qt6/plugins"
for candidate in "$P"/lib/*/plugins "$P"/lib/*/qt6/plugins; do
    [ -d "$candidate" ] && PLUGINS="$PLUGINS:$candidate"
done
export QT_PLUGIN_PATH="$PLUGINS${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
exec "$P/bin/dolphin" "$@"
